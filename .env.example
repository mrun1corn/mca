MONGODB_URI="YOUR_ATLAS_CONNECTION_STRING"
DB_NAME="mca"
# REQUIRED: 32+ characters, must not be a placeholder. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGIN="http://localhost:5173"
PORT=4000

# Optional (used by scripts)
# Required only by the import scripts; there are no built-in default passwords.
ADMIN_NAME="Robin"
ADMIN_EMAIL="robin@example.com"
ADMIN_PASSWORD=""
DEFAULT_USER_PASSWORD=""
EXCEL_PATH="/absolute/path/to/all_payments_summary_admin.xlsx"

# Frontend branding/API base
# For dev with dual ports:
# VITE_API_BASE="http://localhost:4000/api"
# For production single-origin (API serves web):
# VITE_API_BASE="/api"
VITE_APP_NAME="Community Savings"
VITE_APP_LOGO=""  # optional URL or /path

# Paymently / UddoktaPay Gateway
UDDOKTAPAY_BASE_URL="https://your-subdomain.paymently.io/api"
UDDOKTAPAY_API_KEY="your_api_key_here"
API_BASE_URL="http://localhost:4000/api"
WEB_BASE_URL="http://localhost:5173"
